# ============================================================================
# Wardfy configuration — single source of truth for every URL used by OAuth.
#
# The four values below (APP_ORIGIN, API_ORIGIN, and the two provider callbacks)
# define the whole authentication surface. Keep them consistent per environment:
#
#   LOCAL DEV ............... http://127.0.0.1:5173 / http://127.0.0.1:3001
#   GitHub Codespaces ....... auto-detected from CODESPACE_NAME (you can still
#                             override by setting the values explicitly)
#   Production / VPS ........ https://your-domain.com / https://api.your-domain.com
#
# NOTE: Spotify NO LONGER accepts "localhost" as a redirect URI. Local dev MUST
# use an explicit loopback IP (http://127.0.0.1:PORT). Production must use HTTPS.
# Use 127.0.0.1 consistently for local so cookies/redirects share one origin.
# ============================================================================
NODE_ENV=development

# Public origin of the dashboard (what the browser address bar shows).
# Local:      http://127.0.0.1:5173
# Codespaces: https://<codespace>-5173.app.github.dev  (auto-detected if unset)
# Production: https://wardfy.example.com
APP_ORIGIN=http://127.0.0.1:5173

# Public origin of the API. Only used for logging/docs; browser code always uses
# the relative /api proxy, so this is not sent to the browser.
# Local:      http://127.0.0.1:3001
# Codespaces: https://<codespace>-3001.app.github.dev  (auto-detected if unset)
# Production: https://api.wardfy.example.com
API_ORIGIN=http://127.0.0.1:3001

# Vite development proxy target (backend reachable from the dev machine/container).
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# ============================================================================
# API + persistence
# ============================================================================
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://wardfy:wardfy@localhost:5432/wardfy?schema=public
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Spotify has no playback webhook; Wardfy polls connected accounts at this interval.
PLAYBACK_POLL_INTERVAL_SECONDS=30
SPOTIFY_SYNC_CONCURRENCY=4

# ============================================================================
# Spotify OAuth — https://developer.spotify.com/dashboard
# ============================================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local (loopback IP required — "localhost" is rejected by Spotify):
#   http://127.0.0.1:3001/v1/auth/spotify/callback
# Remote/Codespaces (through the /api proxy):
#   https://<codespace>-5173.app.github.dev/api/v1/auth/spotify/callback
# Production:
#   https://wardfy.example.com/api/v1/auth/spotify/callback
# Register THIS EXACT value (path, case, port, no trailing slash changes) in the
# Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/spotify/callback

# ============================================================================
# Discord OAuth + bot — https://discord.com/developers/applications
# ============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local:
#   http://127.0.0.1:3001/v1/auth/discord/callback
# Remote/Codespaces (through the /api proxy):
#   https://<codespace>-5173.app.github.dev/api/v1/auth/discord/callback
# Production:
#   https://wardfy.example.com/api/v1/auth/discord/callback
# Register THIS EXACT value in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/discord/callback
DISCORD_BOT_TOKEN=
# Application ID and Client ID are the same Discord identifier; the bot accepts either.
DISCORD_APPLICATION_ID=
# Server ID used for instant development command registration. The bot must be installed there.
DISCORD_DEV_GUILD_ID=
# Use at least 16 characters (32 random bytes recommended). Must match API and bot exactly.
# Generate with: openssl rand -hex 32
BOT_API_TOKEN=
# Frequency for Discord cards to reconcile API activity.
ACTIVITY_SYNC_INTERVAL_SECONDS=30
# When true, Fastify per-request logs are disabled to reduce console noise.
# Set to true in development if internal traffic is noisy.
DISABLE_REQUEST_LOGGING=true