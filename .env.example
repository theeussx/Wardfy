# Shared runtime settings — standard local development
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
# Optional Vite development proxy target. Browser code always calls relative /api URLs.
VITE_API_PROXY_TARGET=http://localhost:3001
#
# GitHub Codespaces / remote workspace:
# APP_ORIGIN=https://<codespace>-5173.app.github.dev
# API_ORIGIN=https://<codespace>-3001.app.github.dev
# VITE_API_PROXY_TARGET=http://localhost:3001
# Use the APP_ORIGIN URL plus /api in BOTH provider callback URLs below.
# Do not leave OAuth callbacks pointing to localhost when the browser is outside the workspace.

# API + persistence
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://wardfy:wardfy@localhost:5432/wardfy?schema=public
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Spotify has no playback webhook; Wardfy polls connected accounts at this interval.
PLAYBACK_POLL_INTERVAL_SECONDS=30
SPOTIFY_SYNC_CONCURRENCY=4

# Spotify OAuth — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local: http://localhost:3001/v1/auth/spotify/callback
# Remote/Codespaces: https://<codespace>-5173.app.github.dev/api/v1/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:3001/v1/auth/spotify/callback

# Discord OAuth + bot — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://localhost:3001/v1/auth/discord/callback
# Remote/Codespaces: https://<codespace>-5173.app.github.dev/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3001/v1/auth/discord/callback
DISCORD_BOT_TOKEN=
# Application ID and Client ID are the same Discord identifier; the bot accepts either.
DISCORD_APPLICATION_ID=
# Server ID used for instant development command registration. The bot must be installed there.
DISCORD_DEV_GUILD_ID=
# Use at least 16 characters (32 random bytes recommended). Must match API and bot exactly.
# Generate with: openssl rand -hex 32
BOT_API_TOKEN=
# Frequency for Discord cards to reconcile API activity.
ACTIVITY_SYNC_INTERVAL_SECONDS=30