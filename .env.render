# Modelo de variáveis para configurar no Dashboard da Render (não comite este arquivo com valores reais)
NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Dados do banco (já configurados no render.yaml, mas pode sobrescrever no Dashboard se quiser)
DATABASE_URL=postgresql://wardfy:wardfy@postgres:5432/wardfy?schema=public
REDIS_URL=redis://redis:6379

# URLs públicas (atualize APÓS o primeiro deploy com as URLs reais da Render)
APP_ORIGIN=https://wardfy-web.onrender.com
API_ORIGIN=https://wardfy-api.onrender.com

# Callbacks OAuth (devem ser idênticos aos registrados no Spotify / Discord)
SPOTIFY_REDIRECT_URI=https://wardfy-web.onrender.com/api/v1/auth/spotify/callback
DISCORD_REDIRECT_URI=https://wardfy-web.onrender.com/api/v1/auth/discord/callback

# Proxy do Vite (usado no dev local; na produção o nginx faz isso)
VITE_API_PROXY_TARGET=http://api:3001

# Segredos (GERAR COM openssl, NÃO COMITAR)
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEV_GUILD_ID=
BOT_API_TOKEN=

# Configurações de polling / sync
PLAYBACK_POLL_INTERVAL_SECONDS=30
SPOTIFY_SYNC_CONCURRENCY=4
ACTIVITY_SYNC_INTERVAL_SECONDS=30
